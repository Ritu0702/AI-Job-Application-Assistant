              "id": "62412c12-6aa2-420f-b0d2-75182d121c86",
              "leftValue": "={{ Number($('Job Matcher').item.json.output.match(/(?:Overall Match Score|Match Score)[^0-9]*(\\d+)/i)?.[1] || 0) }}",
              "rightValue": 70,
