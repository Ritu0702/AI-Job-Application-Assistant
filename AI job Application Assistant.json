    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Professional Cover Letter Generator.\n\nThe candidate's job match score is 70 or above, so generate a personalized cover letter.\n\nIMPORTANT RULES:\n- Do not invent any skills, experience, education, projects, companies, certifications, or achievements.\n- Use only information present in the resume.\n- Tailor the cover letter to the exact job description.\n- Mention the company name and job title when available.\n- Keep the cover letter professional and concise.\n- Do not mention the match score inside the cover letter.\n\nAfter generating the cover letter, return the COMPLETE result in the following format:\n\nJOB MATCH ANALYSIS\n\n{{ $('Job Matcher').item.json.output }}\n\nCOVER LETTER\n\n[Generate the personalized cover letter here]",
        "options": {}
      },
